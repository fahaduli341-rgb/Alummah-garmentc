{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Garment t-shirt item in store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "shortDescription": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountPercentage": { "type": "number" },
        "category": { "type": "string" },
        "images": { "type": "array" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "stock": { "type": "number" },
        "inStock": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "sku": { "type": "string" },
        "fabric": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "price", "stock", "category"]
    },
    "Category": {
      "title": "Category",
      "description": "T-shirt collection category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order placed",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" },
        "items": { "type": "array" },
        "customer": { "type": "object" },
        "deliveryZone": { "type": "string" },
        "deliveryFee": { "type": "number" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" }
      },
      "required": ["id", "orderNumber", "items", "customer", "total", "status"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store contact and shipping rates configuration",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "phone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "address": { "type": "string" },
        "deliveryInsideDhaka": { "type": "number" },
        "deliveryOutsideDhaka": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store t-shirt catalog"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "T-shirt categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store orders"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Store configuration and delivery charges"
    }
  }
}
