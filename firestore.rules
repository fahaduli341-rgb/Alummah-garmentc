rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products: Public can read, anyone can write with valid structure for catalog management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories: Public can read, admin can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: Anyone can create an order, read for order tracking
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['orderNumber', 'customer', 'items', 'total']);
      allow update, delete: if true;
    }

    // Store Settings: Public can read, admin can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
