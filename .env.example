# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Optional - automatically enabled if provided)
# Enter your Supabase project URL and anon/public API key.
# AL UMMAH GARMENTS works seamlessly with instant persistence out-of-the-box,
# and automatically connects to your live Supabase cloud database when these are set!
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
